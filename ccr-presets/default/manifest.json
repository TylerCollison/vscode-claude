{
  "name": "default",
  "version": "2.0.0",
  "description": "Recommended default configuration that uses a Lite LLM backend with a composition of models",
  "author": "Tyler Collison",
  "keywords": [
    "lite-llm",
    "default"
  ],
  "LOG": false,
  "LOG_LEVEL": "debug",
  "CLAUDE_PATH": "",
  "HOST": "0.0.0.0",
  "PORT": 3456,
  "API_TIMEOUT_MS": "600000",
  "PROXY_URL": "",
  "transformers": [],
  "Providers": [
    {
      "name": "lite-llm",
      "api_base_url": "https://127.0.0.1:5090/v1/chat/completions",
      "api_key": "unused-api-key",
      "models": [
        "lite-llm/default",
        "lite-llm/background",
        "lite-llm/think",
        "lite-llm/longContext",
        "lite-llm/webSearch",
        "lite-llm/image"
      ]
    }
  ],
  "StatusLine": {
    "enabled": false,
    "currentStyle": "default",
    "default": {
      "modules": []
    },
    "powerline": {
      "modules": []
    }
  },
  "Router": {
    "default": "lite-llm,lite-llm/default",
    "background": "lite-llm,lite-llm/background",
    "think": "lite-llm,lite-llm/think",
    "longContext": "lite-llm,lite-llm/longContext",
    "longContextThreshold": 60000,
    "webSearch": "lite-llm,lite-llm/webSearch",
    "image": "lite-llm/image"
  },
  "CUSTOM_ROUTER_PATH": ""
}